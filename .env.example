# Copy to .env (prod/local override) or use .env.development for npm run dev.
# Never commit real secrets. Cognito client IDs are not secret but keep prod IDs out of public forks if concerned.

# --- Cognito (same User Pool for prod and dev; different App Client per environment) ---
VITE_COGNITO_USER_POOL_ID=us-east-1_54eXBuNq1

# Prod app client (playstand.app / prod API)
# VITE_COGNITO_CLIENT_ID=your-prod-client-id
# VITE_API_BASE_URL=https://YOUR_GAME_API_ID.execute-api.us-east-1.amazonaws.com/prod

# Dev app client (localhost + dev.playstand.app) — see stand-backend/docs/DEV_ENVIRONMENT.md
VITE_COGNITO_CLIENT_ID=REPLACE_WITH_DEV_CLIENT_ID
VITE_API_BASE_URL=https://YOUR_GAME_API_ID.execute-api.us-east-1.amazonaws.com/prod
